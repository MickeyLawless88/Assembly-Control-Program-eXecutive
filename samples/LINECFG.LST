0000                  62  ; (shared by parity/data/stop)
0000  =0124           63  PERSV           EQU     $0124           ; 0-9 person>
0000  =0125           64  ECHOV           EQU     $0125           ; 0/1, local>
0000  =012A           65  BAUDV           EQU     $012A           ; 0-2, ACIA >
0000                  66  ; (/1,/16,/64) -- honest divide-ratio labels, not fa>
0000                  67  ; numbers; real baud needs an external clock frequen>
