0000  =7A00           42  ACIA            EQU     $7A00
0000  =8000           43  CRTRAM          EQU     $8000
0000  =0050           44  SCRW            EQU     80
0000  =0018           45  SCRH            EQU     24
0000  =8780           46  CRTEND          EQU     $8780           ; CRTRAM + S>
0000                  47  ; NOT left as an expression (this
0000                  48  ; assembler does not apply operator
0000                  49  ; precedence to "CRTRAM+SCRW*SCRH",
0000                  50  ; confirmed by simulation)
0000  =0067           51  ESCVEC          EQU     $67             ; zero-page >
0000                  52  ; real ESC/char processor, set up by
0000                  53  ; ROM B's own boot init -- confirmed
0000                  54  ; by direct trace, not assumed
0000                  55  
