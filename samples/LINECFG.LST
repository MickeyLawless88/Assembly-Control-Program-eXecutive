0000  =7A00           41  ACIA            EQU     $7A00
0000  =8000           42  CRTRAM          EQU     $8000
0000  =0050           43  SCRW            EQU     80
0000  =0018           44  SCRH            EQU     24
0000  =8780           45  CRTEND          EQU     $8780           ; CRTRAM + S>
0000                  46  ; NOT left as an expression (this
0000                  47  ; assembler does not apply operator
0000                  48  ; precedence to "CRTRAM+SCRW*SCRH",
0000                  49  ; confirmed by simulation)
0000  =0067           50  ESCVEC          EQU     $67             ; zero-page >
0000                  51  ; real ESC/char processor, set up by
0000                  52  ; ROM B's own boot init -- confirmed
0000                  53  ; by direct trace, not assumed
0000                  54  
