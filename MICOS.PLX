/* MICOS.PLX - generated by PLXCFG.  PL/X by Mickey W. Lawless. */

VAR(DECLARATION)
{
    ASSIGN ACT.EQ.'LSI01'
    ASSIGN ACTPW.EQ.'21121'
    ASSIGN MON.EQ.SYSMON
    ASSIGN INT DAY.EQ.SYSDAY
    ASSIGN INT YEAR.EQ.SYSYEAR
    ASSIGN INT USRNO.EQ.4100
    ASSIGN INT PORTNO.EQ.7
    ASSIGN INT TRIES.EQ.0
    ASSIGN INT MAXTRY.EQ.3
    END(DECLARATION)
}

*PROMPT1*["ACCOUNT-ID: ",AID:6A1],'\n'
 IF(AID == ACT) THEN PROCEED *PROMPT2*
 TRIES = TRIES + 1
 IF(TRIES >= MAXTRY) HALT "TOO MANY ATTEMPTS - DISCONNECTED",'\n'
 "INVALID ACCOUNT-ID",'\n'
 RET *PROMPT1*

*PROMPT2*["PASSWORD: ",PAS:6H1],"  ",DATE=[MON,"/",DAY,"/",YEAR],'\n'
 IF(PAS == ACTPW) THEN PROCEED *WELCOME*
 TRIES = TRIES + 1
 IF(TRIES >= MAXTRY) HALT "TOO MANY ATTEMPTS - DISCONNECTED",'\n'
 "INVALID PASSWORD",'\n'
 RET *PROMPT1*

*WELCOME*
BANNER
{
    "+--------------------------------------------------------------------------+",'\n'
    "|                                                                          |",'\n'
    "|                     ###    ####  ####       #                            |",'\n'
    "|                    #   #  #      #   #     #    #   #                    |",'\n'
    "|                    #####  #      ####     #      # #                     |",'\n'
    "|                    #   #  #      #       #       # #                     |",'\n'
    "|                    #   #   ####  #      #       #   #                    |",'\n'
    "|                                                                          |",'\n'
    "|                        ASSEMBLY  CONTROL  PROGRAM                        |",'\n'
    "|           MICOS-STYLE DEVELOPMENT SYSTEM FOR THE MOTOROLA 6800           |",'\n'
    "+==========================================================================+",'\n'
    "|  GOOD DAY, USER ",USRNO:I4,"        SESSION OPENED ",SYSDATE,"        VERSION ",VERSION,"   |",'\n'
    "+==========================================================================+",'\n'
    "|  * ASSEDIT  LINE EDITOR - ENTRY STARTS AT LINE 1, END INPUT WITH //      |",'\n'
    "|  * ASSEMBLER TWO-PASS 6800 ASSEMBLY WITH LISTING AND CROSS-REFERENCE     |",'\n'
    "|  * OUTPUT    NAME.LST LISTING   NAME.S19 S-RECORDS   NAME.BIN ROM IMAGE  |",'\n'
    "|  * TARGET    ORG $E000 = ADM-31 ROM A PLUG-IN SLOT, 2K IMAGE             |",'\n'
    "|  * SCRIPTED  THIS BANNER IS PL/X - SEE ACP.PLX  (BY MICKEY W. LAWLESS)   |",'\n'
    "+--------------------------------------------------------------------------+",'\n'
    "  BELIEVE NOTHING YOU HEAR, AND ONLY ONE HALF THAT YOU SEE.",'\n'
    "  ENTER 'BYE' AT THE ACP PROMPT TO DISCONNECT.",'\n'
    BANNER<END>
}

MENUHDR
{
    "",'\n'
    "'ACP' AT YOUR SERVICE - CHOOSE YOUR OPTION.",'\n'
    "=============================================================",'\n'
}

VAR(LINENUM)
{
    ASSIGN INT LNWIDTH.EQ.5
    ASSIGN INT LNZERO.EQ.1
    END(LINENUM)
}
